\NeedsTeXFormat{LaTeX2e}
% 可编译的中文默认值；当前参考画像与规则通过project-style.tex覆盖。
\ProvidesPackage{modeling}[2026/10/23 Portable mathematical modeling template]

\RequirePackage{iftex}
\RequireXeTeX
\RequirePackage[margin=25mm]{geometry}
\RequirePackage{amsmath,amssymb,bm}
\RequirePackage{booktabs,tabularx,array,graphicx}
\RequirePackage{caption,enumitem,indentfirst}
\RequirePackage{zref-user,zref-abspage}
\RequirePackage{gbt7714}
\setcitestyle{numbers,square,comma}
