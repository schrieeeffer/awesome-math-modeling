% 全部字体由 TeX 发行版提供，不依赖 Windows 专有字体或外置字体文件。
\setmainfont{TeX Gyre Termes}
\setsansfont{TeX Gyre Heros}
\setmonofont{TeX Gyre Cursor}
\setlength{\parindent}{2em}
\setlength{\parskip}{0pt}
\renewcommand{\baselinestretch}{1.38}
\renewcommand{\arraystretch}{1.2}
\ctexset{
  section={format=\centering\heiti\bfseries\zihao{4},
    beforeskip=1.4ex,afterskip=0.7ex},
  subsection={format=\heiti\bfseries\zihao{-4},
    beforeskip=1.1ex,afterskip=0.5ex},
  subsubsection={format=\heiti\bfseries\zihao{-4},
    beforeskip=0.8ex,afterskip=0.4ex}
}
\captionsetup{font=small,labelfont=bf,skip=6pt}
\setlist{nosep,leftmargin=2em}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\newcommand{\slot}[1]{〔待填：#1〕}
\pdfstringdefDisableCommands{\def\slot#1{待填：#1}}
\hypersetup{pdfauthor={},pdftitle={数学建模论文工作模板},
  pdfsubject={可编辑模板；所有研究结果均待填写}}
\pagestyle{plain}
\raggedbottom
\clubpenalty=10000
\widowpenalty=10000

% 物理页标记用于编译后核对，不在页面上印出内部标签。
% 页首标记随所在页写入；正文末先清空浮动，再记录最后已输出的物理页。
\newcommand{\skillmarkpage}[1]{\phantomsection\label{#1}\zlabel{#1}}
\makeatletter
\newcommand{\skillendbody}{%
  \clearpage
  \immediate\write\@auxout{\string\newlabel{skill:body-end}{{}{\number\ReadonlyShipoutCounter}{}{}{}}}%
  \immediate\write\@auxout{\string\zref@newlabel{skill:body-end}{\string\abspage{\number\ReadonlyShipoutCounter}}}%
}
\makeatother

